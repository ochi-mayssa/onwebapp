# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Email (optional in local dev: falls back to the console backend).
# Production uses Resend SMTP - see docs/RESEND_SETUP.md.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
# Preferred: the Resend API key (doubles as the SMTP password).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Legacy alternative to RESEND_API_KEY:
# EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=OnWebApp <notifications@onwebapp.com>
# Used for Django error mails (falls back to DEFAULT_FROM_EMAIL):
SERVER_EMAIL=OnWebApp <server@onwebapp.com>
# Preferred internal recipient for operational notifications:
ADMIN_EMAIL=ops@onwebapp.com
# Public site root used to build absolute links inside emails:
SITE_URL=https://onwebapp.com

# Mandatory email verification (docs/EMAIL_VERIFICATION.md).
# Always forced ON when DEBUG=False; this flag only relaxes local dev.
EMAIL_VERIFICATION_REQUIRED=True

# Email campaigns (admin marketing campaigns) - see docs/EMAIL_CAMPAIGNS.md
CAMPAIGN_MAX_RECIPIENTS=500
CAMPAIGN_BATCH_SIZE=5
CAMPAIGN_BATCH_DELAY_SECONDS=2.5

# Google PageSpeed Insights API (for KPI Performance testing)
PAGESPEED_API_KEY=your-google-api-key-here

# Google Analytics 4 (GA4) OAuth 2.0 credentials
# Create these at https://console.cloud.google.com/apis/credentials
GA4_CLIENT_ID=your-google-oauth-client-id
GA4_CLIENT_SECRET=your-google-oauth-client-secret
GA4_REDIRECT_URI=http://127.0.0.1:8000/platform-monitoring/ga4/callback/

# Stripe (existing payments + automation billing). Leave blank locally.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use a distinct endpoint secret for /automation/billing/webhook/stripe/.
# AUTOMATION_STRIPE_WEBHOOK_SECRET=

# Celery / Redis. USE_CELERY must be True for asynchronous automation execution.
USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Automation execution
# 'inline' is for local development only; production must use 'celery'.
AUTOMATION_EXECUTION_MODE=inline
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOMATION_CREDENTIAL_ENCRYPTION_KEY=
AUTOMATION_EXECUTION_TIMEOUT_SECONDS=60
AUTOMATION_MAX_EXECUTION_ATTEMPTS=3
AUTOMATION_RETRY_BACKOFF_SECONDS=2
AUTOMATION_STALE_EXECUTION_SECONDS=900
AUTOMATION_MAX_STEPS=20
AUTOMATION_MAX_PAYLOAD_BYTES=65536
AUTOMATION_MAX_EMAIL_RECIPIENTS=20
AUTOMATION_OUTBOUND_TIMEOUT_SECONDS=10
AUTOMATION_MAX_HTTP_RESPONSE_BYTES=1048576
AUTOMATION_ALLOWED_OUTBOUND_PORTS=80,443,8443
AUTOMATION_ALLOW_PRIVATE_OUTBOUND=False
AUTOMATION_WEBHOOK_MAX_BODY_BYTES=1048576
