# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Google PageSpeed Insights API (for KPI Performance testing)
PAGESPEED_API_KEY=your-google-api-key-here

# Google Analytics 4 (GA4) OAuth 2.0 credentials
# Create these at https://console.cloud.google.com/apis/credentials
GA4_CLIENT_ID=your-google-oauth-client-id
GA4_CLIENT_SECRET=your-google-oauth-client-secret
GA4_REDIRECT_URI=http://127.0.0.1:8000/platform-monitoring/ga4/callback/
